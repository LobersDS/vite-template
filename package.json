{
  "name": "@lober-ds/create-vite",
  "version": "1.0.0",
  "description": "LobersDS project scaffolder — npm create @lober-ds/vite",
  "type": "module",
  "bin": {
    "create-vite": "./bin/create.mjs"
  },
  "files": [
    "bin",
    "template"
  ],
  "scripts": {
    "test": "wireit",
    "lint": "wireit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "wireit",
    "clean": "rm -rf .wireit"
  },
  "wireit": {
    "test": {
      "command": "node bin/create.mjs --self-test",
      "files": [
        "bin/**",
        "template/**"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "bin/**",
        "eslint.config.js"
      ],
      "output": []
    },
    "format:check": {
      "command": "prettier --check .",
      "files": [
        "bin/**",
        "*.config.*",
        ".prettierrc*",
        "*.json",
        "*.md"
      ],
      "output": []
    }
  },
  "keywords": [
    "lober-ds",
    "vite",
    "vue",
    "scaffolder",
    "create"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.0",
    "wireit": "^0.14.0"
  }
}
