# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-site
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

{{#VAULT}}
# Obsidian — workspace state (open files, cursor positions)
{{VAULT_NAME}}/.obsidian/workspace.json

# Obsidian plugin binaries — contributors install these via the plugin browser.
{{VAULT_NAME}}/.obsidian/plugins/*/main.js
{{VAULT_NAME}}/.obsidian/plugins/*/styles.css

# Obsidian / Claude plugin data that may contain API keys or personal info
{{VAULT_NAME}}/.claudian/
{{VAULT_NAME}}/.obsidian/plugins/obsidian-excalidraw-plugin/data.json
{{VAULT_NAME}}/.obsidian/plugins/realclaudian/data.json
{{/VAULT}}

{{#WIREIT}}
# Wireit build cache
.wireit/
{{/WIREIT}}

# Test artifacts
test-results/
{{#SMOKETEST}}smoke-test/test-results/{{/SMOKETEST}}
